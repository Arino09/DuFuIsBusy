extends SceneTree
const Surface = preload("res://scripts/drawing_surface.gd")
func _initialize() -> void:
	call_deferred("run")
func run() -> void:
	var surface = Surface.new()
	surface.state = Surface.new_state()
	surface.size = Vector2(1040, 330)
	root.add_child(surface)
	assert(not surface.has_ink())
	surface.erasing = true
	surface.begin(Vector2(30, 30), -1)
	surface.finish()
	assert(surface.state.undo.is_empty())
	surface.erasing = false
	surface.begin(Vector2(-10, -10), -1)
	assert(not surface.active)
	surface.begin(Vector2(450, 150), -1)
	surface.move_pen(Vector2(550, 150))
	surface.finish()
	assert(surface.has_ink() and surface.state.undo.size() == 1)
	var original = surface.state.pixels.get_data()
	surface.erasing = true
	surface.pen_width = 56
	surface.begin(Vector2(430, 150), -1)
	surface.move_pen(Vector2(570, 150))
	surface.finish()
	assert(not surface.has_ink())
	surface.travel(false)
	assert(surface.state.pixels.get_data() == original)
	surface.travel(true)
	assert(not surface.has_ink())
	surface.erasing = false
	surface.begin(Vector2(1039, 329), -1)
	surface.move_pen(Vector2(1200, 500))
	assert(not surface.active and surface.has_ink())
	assert(surface.state.redo.is_empty())
	var state = surface.state
	surface.queue_free()
	await process_frame
	var rebuilt = Surface.new()
	rebuilt.state = state
	rebuilt.size = Vector2(1040, 330)
	root.add_child(rebuilt)
	assert(rebuilt.has_ink())
	assert(rebuilt.state.pixels.get_size() == Vector2i(1040, 330))
	for i in range(25):
		rebuilt.begin(Vector2(300 + i * 20, 100), -1)
		rebuilt.finish()
	assert(rebuilt.state.undo.size() == 20)
	rebuilt.travel(false)
	assert(rebuilt.state.redo.size() == 1)
	rebuilt.begin(Vector2(900, 250), -1)
	rebuilt.finish()
	assert(rebuilt.state.redo.is_empty())
	var objects = Surface.new()
	objects.state = Surface.new_state()
	objects.size = Vector2(1040, 330)
	root.add_child(objects)
	assert(not objects.has_creation())
	objects.selecting = true
	objects.begin(Vector2(150, 160), 0)
	objects.move_pen(Vector2(850, 160))
	objects.finish()
	assert(objects.has_creation() and not objects.has_ink())
	objects.travel(false)
	assert(not objects.has_creation())
	objects.select_at(Surface.DEFAULT_POSITION)
	var avatar_before = objects.selected_object().duplicate(true)
	var revision_before = objects.state.revision
	var undo_before = objects.state.undo.size()
	var redo_before = objects.state.redo.size()
	var changes = [0]
	objects.changed.connect(func(): changes[0] += 1)
	objects.transform_selected(1, PI / 4)
	objects.transform_selected(1, -PI / 4)
	assert(objects.selected_object() == avatar_before, "Avatar rotation must be ignored")
	assert(objects.state.revision == revision_before and changes[0] == 0)
	assert(objects.state.undo.size() == undo_before and objects.state.redo.size() == redo_before)
	objects.transform_selected(0.85, PI / 4)
	assert(is_equal_approx(objects.selected_object().scale, 0.85), "Avatar scaling stays available")
	assert(is_zero_approx(objects.selected_object().rotation))
	assert(changes[0] == 1 and objects.state.revision == revision_before + 1)
	objects.travel(false)
	assert(not objects.has_creation())
	for kind in Surface.STICKER_TEXTURES:
		objects.add_object(kind)
		var weapon = objects.selected_object()
		var extent = objects.dimensions(weapon)
		var source_size = Surface.STICKER_TEXTURES[kind].get_size()
		assert(extent.x > 0 and extent.y > 0)
		assert(is_equal_approx(extent.x / extent.y, source_size.x / source_size.y))
		objects.begin(weapon.position, 0)
		objects.move_pen(weapon.position + Vector2(80, 15))
		objects.finish()
		assert(weapon.position.is_equal_approx(Vector2(660, 180)))
		objects.transform_selected(2, PI / 4)
		assert(is_equal_approx(weapon.rotation, PI / 4), "Sticker rotation stays available")
		var half_extent = objects.dimensions(weapon) / 2
		for corner in [Vector2(-half_extent.x, -half_extent.y), Vector2(half_extent.x, -half_extent.y), half_extent, Vector2(-half_extent.x, half_extent.y)]:
			var point = objects.transform_for(weapon) * corner
			assert(point.x >= -0.01 and point.y >= -0.01 and point.x <= 1040.01 and point.y <= 330.01)
		objects.remove_selected()
		assert(objects.state.objects.size() == 1)
	objects.add_object("star")
	assert(objects.state.objects.size() == 1, "Retired stickers can no longer be added")
	objects.add_object("weapon_du")
	objects.transform_selected(2, PI / 4)
	var transformed = objects.selected_object().duplicate(true)
	objects.remove_selected()
	assert(not objects.has_creation())
	objects.travel(false)
	assert(objects.state.objects[1] == transformed)
	objects.add_object("text", "龘麒麟逍遥游", 64, Color.RED)
	assert(objects.has_creation() and objects.state.objects.size() == 3)
	objects.edit_text("临江仙，风起！", 48, Color.BLUE)
	assert(objects.selected_object().text == "临江仙，风起！")
	objects.transform_selected(2, PI / 2)
	var selected = objects.selected_object()
	assert(selected.position.x >= 0 and selected.position.y >= 0)
	var half = objects.dimensions(selected) / 2
	for corner in [Vector2(-half.x,-half.y),Vector2(half.x,-half.y),half,Vector2(-half.x,half.y)]:
		var point = objects.transform_for(selected) * corner
		assert(point.x >= -0.01 and point.y >= -0.01 and point.x <= 1040.01 and point.y <= 330.01)
	objects.travel(false)
	assert(objects.state.objects[2].rotation == 0)
	objects.travel(true)
	assert(is_equal_approx(objects.state.objects[2].rotation, PI / 2))
	objects.select_at(Vector2(1030, 320))
	assert(objects.selected_object().is_empty())
	for character in "龘麒麟逍遥游临江仙风起": assert(Surface.CREATIVE_FONT.has_char(character.unicode_at(0)))
	print("DRAWING_TESTS_PASSED")
	quit()
