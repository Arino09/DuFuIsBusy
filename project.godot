; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DuFuIsBusy"
config/description="杜甫很忙 · 本地绘画与趣味点评"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

WwiseRuntimeManager="*res://scripts/audio/wwise_runtime_manager.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.94, 0.91, 0.84, 1)

[wwise]

common_user_settings/root_output_path="res://addons/Wwise/wwise_project/DuFuIsBusy/GeneratedSoundBanks"
project_settings/windows_platform_info="res://Wwise/resources/Windows.tres"
project_settings/mac_platform_info="res://Wwise/resources/Mac.tres"
project_settings/android_platform_info="res://Wwise/resources/Android.tres"
project_settings/web_platform_info="res://Wwise/resources/Web.tres"
